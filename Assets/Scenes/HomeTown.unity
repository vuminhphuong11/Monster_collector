    - target: {fileID: 2879168420635078504, guid: 0e6e4b04e036d884a89c20e9868502e2, type: 3}
      propertyPath: dialog.lines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 2879168420635078504, guid: 0e6e4b04e036d884a89c20e9868502e2, type: 3}
      propertyPath: dialog.lines.Array.data[0]
      value: "Nice beginner gear. It\u2019ll make a great snack for the local wildlife"
      objectReference: {fileID: 0}
    - target: {fileID: 2879168420635078504, guid: 0e6e4b04e036d884a89c20e9868502e2, type: 3}
      propertyPath: dialog.lines.Array.data[1]
      value: "I\u2019ve already leveled up to 5 and I\u2019m still terrified of the
        tall grass, yet here you are acting like a champion"
      objectReference: {fileID: 0}
    - target: {fileID: 2879168420635078504, guid: 0e6e4b04e036d884a89c20e9868502e2, type: 3}
      propertyPath: dialog.lines.Array.data[2]
      value: The confidence of the weak is truly a terrifying weapon
      objectReference: {fileID: 0}
    - target: {fileID: 2879168420635078504, guid: 0e6e4b04e036d884a89c20e9868502e2, type: 3}
      propertyPath: dialog.lines.Array.data[3]
      value: "Here\u2019s a tip: go tickle the monsters around here for a few more
        hours,"
      objectReference: {fileID: 0}
    - target: {fileID: 2879168420635078504, guid: 0e6e4b04e036d884a89c20e9868502e2, type: 3}
      propertyPath: dialog.lines.Array.data[4]
      value: hero'. Maybe by then, you'll actually look like you belong in a battle
        system instead of a hospital."
      objectReference: {fileID: 0}
