    - target: {fileID: 2879168420635078504, guid: 0e6e4b04e036d884a89c20e9868502e2, type: 3}
      propertyPath: timeBetWeenPattern
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 2879168420635078504, guid: 0e6e4b04e036d884a89c20e9868502e2, type: 3}
      propertyPath: dialog.lines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 2879168420635078504, guid: 0e6e4b04e036d884a89c20e9868502e2, type: 3}
      propertyPath: dialog.lines.Array.data[0]
      value: Welcome, soon-to-be-corpse! Looking to buy some potions?
      objectReference: {fileID: 0}
    - target: {fileID: 2879168420635078504, guid: 0e6e4b04e036d884a89c20e9868502e2, type: 3}
      propertyPath: dialog.lines.Array.data[1]
      value: "Honestly, with your current Max HP, a wild monster\u2019s sneeze would
        be a finishing move"
      objectReference: {fileID: 0}
    - target: {fileID: 2879168420635078504, guid: 0e6e4b04e036d884a89c20e9868502e2, type: 3}
      propertyPath: dialog.lines.Array.data[2]
      value: Instead of wasting money on medicine you won't live long enough to swallow,
        why don't you spend some time bullying weaklings to gain some EXP?
      objectReference: {fileID: 0}
    - target: {fileID: 2879168420635078504, guid: 0e6e4b04e036d884a89c20e9868502e2, type: 3}
      propertyPath: dialog.lines.Array.data[3]
      value: "Come back when your level is higher than my blood pressure, and maybe
        I\u2019ll give you a discount."
      objectReference: {fileID: 0}
